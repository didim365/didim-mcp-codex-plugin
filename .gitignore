# --- Secrets / API keys (never commit) ---
.env
.env.*
*.env
config.toml
*.secret
*.key
config.toml.backup-*
*.backup-*
*api*key*
*apikey*
didim-vault-key*
secrets.*
# Agent rule doc, not a secret store. The pattern above would otherwise hide it
# even though CLAUDE.md references it.
!.claude/rules/secrets.md

# --- Codex / plugin local state ---
.codex/
.codex-home/
plugins/cache/
plugins/**/state/

# --- Python (Skill Registry backend) ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node / React Admin (web/) ---
web/node_modules/
web/dist/
web/.vite/
*.tsbuildinfo

# --- Logs & temp artifacts ---
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig
*~

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# 사내망 TLS 검사 CA — public 저장소에 커밋하지 않는다. certs/README.md 참고.
certs/*.crt
