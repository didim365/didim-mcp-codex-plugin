# --- Secrets / API keys (never commit) ---
.env
.env.*
*.env
config.toml
*.secret
*.key
config.toml.backup-*
*.backup-*
*api*key*
*apikey*
didim-vault-key*
secrets.*
# Agent rule doc, not a secret store. The pattern above would otherwise hide it
# even though CLAUDE.md references it.
!.claude/rules/secrets.md

# --- Codex / plugin local state ---
.codex/
.codex-home/
plugins/cache/
plugins/**/state/

# --- Logs & temp artifacts ---
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig
*~

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
